#
# Orbit's own Chromium embedder. Lives in the Orbit repository at
# Chromium/Embedder/ and is reached from inside the (gitignored, resynced)
# Chromium checkout only through a symlink --
# ThirdParty/chromium/src/orbit -> Chromium/Embedder --
# that Scripts/chromium (chromium_manager.py: link_embedder_source())
# recreates after every gclient sync. See Chromium/README.md for why a
# symlink and not a DEPS entry or checked-in tree: depot_tools'
# `gclient sync --reset --delete_unversioned_trees` deletes untracked
# directories under src/ but explicitly skips symlinks
# (gclient_scm.py: `if not os.path.islink(full_path): ... rmtree`), so this
# is the one mechanism that survives both a resync and a fresh clone without
# ever writing into the checkout itself.
#
# GN resolves //orbit/... through that symlink exactly like any other
# on-disk directory; nothing here is special-cased by GN or ninja.
#
# Structured after content/shell/BUILD.gn's `is_mac` block, which is the
# canonical example of an embedder producing a macOS framework + helper
# .app family from //content. The one deliberate divergence: content_shell's
# helper template links the framework directly ("+link_nested") in a
# component build, purely for build speed. Orbit's helper template never
# does that -- see the process-and-sandbox design note, section 1: the
# helper must dlopen() the framework strictly after Seatbelt is initialised,
# and dlopen is what applies in every configuration, component build or not.

import("//build/apple/tweak_info_plist.gni")
import("//build/buildflag_header.gni")
import("//build/config/mac/rules.gni")
import("//content/public/app/mac_helpers.gni")
import("//mojo/public/tools/bindings/mojom.gni")
import("//third_party/ffmpeg/ffmpeg_options.gni")
import("//third_party/icu/config.gni")
import("//tools/grit/repack.gni")
import("//tools/v8_context_snapshot/v8_context_snapshot.gni")
import("//ui/gl/features.gni")
import("//v8/gni/v8.gni")

assert(is_mac, "Orbit's embedder is macOS-only.")

orbit_product_name = "Orbit"
orbit_version = "1.0.0.0"

group("orbit") {
  deps = [
    ":orbit_framework",
    ":orbit_selftest",
  ]
}

# Build-validation tool only; never embedded in a shipped bundle. See
# app/orbit_selftest_main.cc.
executable("orbit_selftest") {
  sources = [ "app/orbit_selftest_main.cc" ]
  deps = [ ":orbit_framework" ]
}

# "Chrome" branding is what puts ffmpeg's H.264/AAC decoders in the binary;
# proprietary_codecs alone only advertises them.
orbit_bundled_proprietary_decoders = ffmpeg_branding == "Chrome"

buildflag_header("media_buildflags") {
  header = "orbit_media_buildflags.h"
  flags = [
    "ORBIT_BUNDLED_PROPRIETARY_DECODERS=$orbit_bundled_proprietary_decoders",
  ]
}

# Browser<->renderer wiring for user-script injection and the page->native
# message channel -- see common/orbit_mojom.mojom's file comment.
mojom("mojo_bindings") {
  cpp_only = true
  sources = [ "common/orbit_mojom.mojom" ]
}

orbit_framework_name = "$orbit_product_name Framework"
orbit_helper_name = "$orbit_product_name Helper"

tweak_info_plist("orbit_framework_plist") {
  info_plist = "app/framework-Info.plist"
  args = [
    "--breakpad=0",
    "--keystone=0",
    "--scm=0",
    "--version",
    orbit_version,
    "--branding",
    orbit_product_name,
  ]
}

