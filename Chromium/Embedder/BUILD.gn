mac_framework_bundle("orbit_framework") {
  output_name = orbit_framework_name
  framework_version = "A"
  framework_contents = [
    "Headers",
    "Helpers",
    "Libraries",
    "Resources",
  ]

  sources = []

  deps = [
    ":orbit_lib",
    "//content/public/app",
    "//content/public/common",
    "//third_party/icu:icudata",
  ]

  bundle_deps = [
    ":orbit_framework_headers",
    ":orbit_framework_helpers",
    ":orbit_framework_libraries",
    ":orbit_framework_resources",
  ]

  if (!is_component_build) {
    ldflags =
        [ "-Wl,-install_name,@executable_path/../Frameworks/$output_name.framework/$output_name" ]
  } else {
    # See the file-level comment: the helper never links the framework, so
    # this is only about the app-side (never-sandboxed) browser process
    # finding it conveniently. Matches content_shell's non-helper rationale.
    ldflags = [
      "-Wl,-install_name,@rpath/$output_name.framework/$output_name",
      "-Wl,-rpath,@loader_path/../../../../../..",
    ]
  }

  info_plist_target = ":orbit_framework_plist"
}

tweak_info_plist("orbit_helper_plist") {
  info_plist = "app/helper-Info.plist"
  args = [
    "--breakpad=0",
    "--keystone=0",
    "--scm=0",
    "--version",
    orbit_version,
  ]
}

# Every helper flavour dlopen()s the framework; none of them ever link it,
# in any build configuration. That is the whole point of this template
# existing separately from content_shell_helper_app.
template("orbit_helper_app") {
  mac_app_bundle(target_name) {
    assert(defined(invoker.helper_name_suffix))
    assert(defined(invoker.helper_bundle_id_suffix))

    output_name = orbit_helper_name + invoker.helper_name_suffix

    sources = [ "app/orbit_main_mac.cc" ]
    defines = [ "HELPER_EXECUTABLE" ]
    extra_substitutions =
        [ "ORBIT_HELPER_BUNDLE_ID_SUFFIX=${invoker.helper_bundle_id_suffix}" ]
    deps = [
      "//base/allocator:early_zone_registration_apple",
      "//sandbox/mac:seatbelt",
    ]

    if (is_component_build) {
      # //sandbox/mac:seatbelt is linked directly (it runs before the
      # framework is even dlopen()'d, so it cannot itself come from the
      # framework) and in a component build it is a loose .dylib sitting in
      # root_out_dir rather than inside this bundle. This rpath is only
      # about finding *that* sibling dylib; it must never be widened into
      # linking or dlopen()ing the framework early -- see the file comment.
      ldflags = [ "-Wl,-rpath,@executable_path/../../../../../../.." ]
    }

    info_plist_target = ":orbit_helper_plist"
  }
}

foreach(helper_params, content_mac_helpers) {
  orbit_helper_app("orbit_helper_app_${helper_params[0]}") {
    helper_name_suffix = helper_params[2]
    helper_bundle_id_suffix = helper_params[1]
  }
}

# Blink's default (user-agent) style sheets, images, localised strings and
# WebUI/devtools resources, repacked into one archive read by every process
# through ui::ResourceBundle. Without this,
# CSSDefaultStyleSheets::EnsureDefaultStyleSheetsForElements() (and every
# other GetDataResource() caller) has no UA CSS to hand out, so <style>/CSS
# is never applied and its text is rendered as-is; see also the CHECK in
# ui::ResourceBundle::GetSharedInstance() that fires the moment anything
# calls it before InitSharedInstanceWithPakPath(). Mirrors content/shell/
# BUILD.gn's repack("pak") minus content_shell's own chrome://*-internals,
# UI-toolkit and test-only pieces, none of which Orbit ships.
repack("orbit_resources_pak") {
  sources = [
    "$root_gen_dir/content/content_resources.pak",
    "$root_gen_dir/content/gpu_resources.pak",
    "$root_gen_dir/content/browser/devtools/devtools_resources.pak",
    "$root_gen_dir/extensions/extensions_browser_resources_100_percent.pak",

    # Every extensions renderer JS module CoreExtensionsRendererAPIProvider::
    # PopulateSourceMap() registers by name (webRequestEvent, utils, setIcon,
    # contextMenus, permissions, guestView, ...) lives in this pak, not in
    # extensions_renderer_resources.pak -- that grd carries only
    # IDR_EXTENSION_CSS. Omitting it leaves the names registered but their
    # resource ids absent, so the first ModuleSystem::Require() of any of them
    # kills the renderer in ResourceBundleSourceMap::GetSource(). Upstream's
    # own extensions repack (extensions/BUILD.gn's shell_and_test_pak) lists
    # both. OrbitExtensionsRendererAPIProvider asserts the whole set resolves.
    "$root_gen_dir/extensions/extensions_renderer_generated_resources.pak",
    "$root_gen_dir/extensions/extensions_renderer_resources.pak",
    "$root_gen_dir/extensions/extensions_resources.pak",
    "$root_gen_dir/extensions/strings/extensions_strings_en-US.pak",
    "$root_gen_dir/mojo/public/js/mojo_bindings_resources.pak",
    "$root_gen_dir/net/net_resources.pak",
    "$root_gen_dir/third_party/blink/public/resources/blink_resources.pak",
    "$root_gen_dir/third_party/blink/public/resources/blink_scaled_resources_100_percent.pak",
    "$root_gen_dir/third_party/blink/public/resources/inspector_overlay_resources.pak",
    "$root_gen_dir/third_party/blink/public/strings/blink_strings_en-US.pak",
    "$root_gen_dir/third_party/blink/public/strings/permission_element_generated_strings.pak",
    "$root_gen_dir/third_party/blink/public/strings/permission_element_strings_en-US.pak",
    "$root_gen_dir/ui/resources/ui_resources_100_percent.pak",
    "$root_gen_dir/ui/strings/app_locale_settings_en-US.pak",
    "$root_gen_dir/ui/strings/auto_image_annotation_strings_en-US.pak",
    "$root_gen_dir/ui/strings/ax_strings_en-US.pak",
    "$root_gen_dir/ui/strings/ui_strings_en-US.pak",
    "$root_gen_dir/ui/webui/resources/webui_resources.pak",
  ]
  deps = [
    "//content:content_resources",
    "//content/browser/devtools:devtools_resources",
    "//content/browser/resources/gpu:resources_grit",
    "//extensions:extensions_resources",
    "//extensions/strings",
    "//mojo/public/js:resources",
    "//net:net_resources",
    "//third_party/blink/public:devtools_inspector_resources",
    "//third_party/blink/public:resources",
    "//third_party/blink/public:scaled_resources_100_percent",
    "//third_party/blink/public/strings",
    "//third_party/blink/public/strings:permission_element_generated_strings",
    "//third_party/blink/public/strings:permission_element_strings",
    "//ui/resources",
    "//ui/strings",
    "//ui/webui/resources",
  ]
  output = "$root_out_dir/orbit_resources.pak"
}

# content::ContentMainRunnerImpl::Initialize() CHECK-fails
# (base/i18n/icu_util.cc) without this -- see content/shell/BUILD.gn's
# content_shell_framework_resources for the target this mirrors.
bundle_data("orbit_framework_resources") {
  sources = [ "$root_out_dir/orbit_resources.pak" ]
  outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
  public_deps = [ ":orbit_resources_pak" ]
  if (icu_use_data_file) {
    sources += [ "$root_out_dir/icudtl.dat" ]
    public_deps += [ "//third_party/icu:icudata" ]
  }
  if (v8_use_external_startup_data) {
    # gin::V8Initializer::LoadV8Snapshot() CHECK-fails (gin/v8_initializer.cc)
    # without these -- see content/shell/BUILD.gn's
    # content_shell_framework_resources for the target this mirrors.
    if (use_v8_context_snapshot) {
      sources += [ "$root_out_dir/$v8_context_snapshot_filename" ]
      public_deps += [ "//tools/v8_context_snapshot" ]
    }
    if (!use_v8_context_snapshot || include_both_v8_snapshots) {
      sources += [ "$root_out_dir/snapshot_blob.bin" ]
    }
  }
}

# The GPU process CHECK-fails (ui/gl/gl_implementation.cc) without these --
# see content/shell/BUILD.gn's content_shell_angle_binaries/
# content_shell_swiftshader_binaries/content_shell_vulkan_binaries, the
# targets this mirrors.
bundle_data("orbit_framework_libraries") {
  sources = []
  outputs = [ "{{bundle_contents_dir}}/Libraries/{{source_file_part}}" ]
  public_deps = []
  if (!use_static_angle) {
    sources += [
      "$root_out_dir/egl_intermediates/libEGL.dylib",
      "$root_out_dir/egl_intermediates/libGLESv2.dylib",
    ]
    public_deps += [ "//ui/gl:angle_library_copy" ]
  }
  sources += [
    "$root_out_dir/vk_intermediates/libvk_swiftshader.dylib",
    "$root_out_dir/vk_intermediates/vk_swiftshader_icd.json",
  ]
  public_deps += [ "//ui/gl:swiftshader_vk_library_copy" ]
  sources += [ "$root_out_dir/vulkan_intermediates/libvulkan.dylib" ]
  public_deps += [ "//ui/gl:vulkan_loader_library_copy" ]
}

# Chromium.xcconfig's HEADER_SEARCH_PATHS already points at
# "Orbit Framework.framework/Headers"; this is the only file that lands
# there. Swift never #includes it directly (see the file comment in
# orbit_bridge_api.h) but the C++ side and any future Objective-C++ bridge
# code can.
bundle_data("orbit_framework_headers") {
  sources = [ "bridge/orbit_bridge_api.h" ]
  outputs = [ "{{bundle_contents_dir}}/Headers/{{source_file_part}}" ]
}

bundle_data("orbit_framework_helpers") {
  sources = []
  outputs = [ "{{bundle_contents_dir}}/Helpers/{{source_file_part}}" ]
  public_deps = []
  foreach(helper_params, content_mac_helpers) {
    sources += [ "$root_out_dir/${orbit_helper_name}${helper_params[2]}.app" ]
    public_deps += [ ":orbit_helper_app_${helper_params[0]}" ]
  }
}
