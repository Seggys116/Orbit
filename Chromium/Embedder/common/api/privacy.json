[
  {
    "namespace": "privacy",
    "description": "Use the <code>chrome.privacy</code> API to control usage of the features in the browser that can affect a user's privacy. This API relies on the ChromeSetting prototype of the type API for getting and setting the browser's configuration.",
    "properties": {
      "services": {
        "type": "object",
        "value": {},
        "description": "Settings that enable or disable features that require third-party network services.",
        "properties": {
          "searchSuggestEnabled": {
            "$ref": "types.ChromeSetting",
            "value": ["searchSuggestEnabled", {"type": "boolean"}],
            "description": "If enabled, the browser sends the text you type into the command bar to your search engine, which returns suggested completions. This preference's value is a boolean, defaulting to <code>true</code>."
          }
        }
      }
    }
  }
]
