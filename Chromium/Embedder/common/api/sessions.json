[
  {
    "namespace": "sessions",
    "description": "Use the <code>chrome.sessions</code> API to query and restore tabs from a browsing session.",
    "types": [
      {
        "id": "Filter",
        "type": "object",
        "properties": {
          "maxResults": {
            "type": "integer",
            "minimum": 0,
            "maximum": 25,
            "optional": true,
            "description": "The maximum number of entries to be fetched in the requested list. Omit this parameter to fetch the maximum number of entries ($(ref:sessions.MAX_SESSION_RESULTS))."
          }
        }
      },
      {
        "id": "Session",
        "type": "object",
        "properties": {
          "lastModified": {
            "type": "integer",
            "description": "The time when the tab was closed, represented in seconds since the epoch."
          },
          "tab": {
            "$ref": "tabs.Tab",
            "optional": true,
            "description": "The $(ref:tabs.Tab) this entry describes. Its <code>id</code> is $(ref:tabs.TAB_ID_NONE) while it is closed; its <code>sessionId</code> is what $(ref:sessions.restore) takes."
          },
          "window": {
            "$ref": "windows.Window",
            "optional": true,
            "description": "The $(ref:windows.Window), if this entry describes a window. Never set by Orbit, which tracks no closed windows."
          }
        }
      }
    ],
    "functions": [
      {
        "name": "getRecentlyClosed",
        "type": "function",
        "description": "Gets the list of recently closed tabs.",
        "parameters": [
          {
            "$ref": "Filter",
            "name": "filter",
            "optional": true
          }
        ],
        "returns_async": {
          "name": "callback",
          "parameters": [
            {
              "name": "sessions",
              "type": "array",
              "items": { "$ref": "Session" },
              "description": "The list of closed entries in reverse order that they were closed (the most recently closed tab will be at index <code>0</code>)."
            }
          ]
        }
      },
      {
        "name": "restore",
        "type": "function",
        "description": "Reopens a $(ref:tabs.Tab), with an optional callback to run when the entry has been restored.",
        "parameters": [
          {
            "type": "string",
            "name": "sessionId",
            "optional": true,
            "description": "The $(ref:tabs.Tab.sessionId) to restore. If this parameter is not specified, the most recently closed session is restored."
          }
        ],
        "returns_async": {
          "name": "callback",
          "optional": true,
          "parameters": [
            {
              "$ref": "Session",
              "name": "restoredSession",
              "description": "A $(ref:sessions.Session) containing the restored $(ref:tabs.Tab)."
            }
          ]
        }
      }
    ],
    "events": [
      {
        "name": "onChanged",
        "description": "Fired when recently closed tabs are changed.",
        "type": "function"
      }
    ],
    "properties": {
      "MAX_SESSION_RESULTS": {
        "value": 25,
        "description": "The maximum number of $(ref:sessions.Session) that will be included in a requested list. Matches Orbit's own recently-closed capacity."
      }
    }
  }
]
