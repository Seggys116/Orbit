//
// Availability of Orbit's own action/tabs/webNavigation/windows API surface
// (see action.json, tabs.json, web_navigation.json, windows.json). Mirrors
// the shape -- not the full contents -- of chrome/common/extensions/api/
// _api_features.json's matching entries: privileged extension contexts only,
// no webui/webui_untrusted carve-outs, since Orbit has no such surfaces these
// APIs should reach.
{
  // Gated on the manifest key rather than a permission, exactly as
  // chrome/common/extensions/api/_api_features.json gates it: an extension
  // with no "action" block has no action to control. The manifest:action
  // feature itself is //extensions-core (extensions/common/api/
  // _manifest_features.json), so nothing needs adding for it here.
  "action": {
    "dependencies": ["manifest:action"],
    "contexts": ["privileged_extension"]
  },
  "action.isEnabled": {
    "channel": "stable"
  },
  "action.getBadgeTextColor": {
    "channel": "stable"
  },
  "action.setBadgeTextColor": {
    "channel": "stable"
  },
  "cookies": {
    "dependencies": ["permission:cookies"],
    "contexts": ["privileged_extension"]
  },
  // No permission dependency, exactly as chrome/common/extensions/api/
  // _api_features.json gates it: chrome.permissions is how an extension asks
  // for its own declared optional permissions, so requiring a permission to
  // reach it would be circular. Every grant is still bounded by the
  // manifest's own optional_permissions -- see orbit_permissions_api.cc.
  "permissions": {
    "channel": "stable",
    "extension_types": ["extension"],
    "contexts": ["privileged_extension"]
  },
  "privacy": {
    "dependencies": ["permission:privacy"],
    "contexts": ["privileged_extension"]
  },
  "tabs": {
    "channel": "stable",
    "extension_types": ["extension"],
    "contexts": ["privileged_extension"]
  },
  "windows": {
    "channel": "stable",
    "extension_types": ["extension"],
    "contexts": ["privileged_extension"],
    "dependencies": ["api:tabs"]
  },
  "webNavigation": {
    "channel": "stable",
    "extension_types": ["extension"],
    "contexts": ["privileged_extension"],
    "dependencies": ["permission:webNavigation"]
  }
}
