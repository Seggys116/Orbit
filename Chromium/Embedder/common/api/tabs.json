//
// A deliberately small subset of chrome/common/extensions/api/tabs.json:
// only the functions and events real installed extensions were observed
// calling (query, create, update, remove, reload, get, getCurrent,
// sendMessage, connect; onCreated, onUpdated, onRemoved, onActivated,
// onMoved, onReplaced). Backed by
// orbit::OrbitTabRegistry, itself fed by Orbit's own Swift tab store (see
// Chromium/Embedder/bridge/orbit_bridge_api.h's OrbitTabs* functions) --
// not by a chrome/browser/ui Browser/TabStripModel, which Orbit has none of.
// Extending this file (tabGroups, highlight, duplicate, discard, capture,
// zoom, moving a tab between windows, ...) is explicitly out of scope for
// this pass; see the RegisterExtensionFunctions() call site for exactly
// which functions are wired up. sendMessage/connect are the exception: they
// have no ExtensionFunction at all, they are handled entirely in the
// renderer by OrbitTabsHooksDelegate (renderer/orbit_tabs_hooks_delegate.h),
// which is why both carry "nocompile".
[
  {
    "namespace": "tabs",
    "description": "A focused subset of chrome.tabs, backed by Orbit's own tab model.",
    "compiler_options": {
      "implemented_in": "orbit/browser/api/tabs/orbit_tabs_api.h"
    },
    "types": [
      {
        "id": "TabStatus",
        "type": "string",
        "enum": ["loading", "complete"],
        "description": "The tab's loading status."
      },
      {
        "id": "WindowType",
        "type": "string",
        "enum": ["normal", "popup", "panel", "app", "devtools"],
        "description": "The type of window. Every Orbit window is \"normal\"."
      },
      {
        "id": "MutedInfo",
        "type": "object",
        "properties": {
          "muted": {"type": "boolean", "description": "Whether the tab is muted (prevented from playing sound)."}
        }
      },
      {
        "id": "Tab",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "optional": true,
            "minimum": -1,
            "description": "A stable Orbit-assigned tab id, unique only for this run. chrome.tabs.TAB_ID_NONE (-1) for a tab this call could not resolve."
          },
          "index": {"type": "integer", "minimum": -1, "description": "The tab's position within its window."},
          "windowId": {"type": "integer", "minimum": -1, "description": "The id of the window that contains this tab."},
          "active": {"type": "boolean", "description": "Whether this tab is the active tab in its window."},
          "pinned": {"type": "boolean", "description": "Whether this tab is pinned."},
          "url": {
            "type": "string",
            "optional": true,
            "description": "The tab's last committed URL. Only present if the extension has the \"tabs\" permission or a host permission matching that URL."
          },
          "pendingUrl": {
            "type": "string",
            "optional": true,
            "description": "The URL the tab is navigating to, before it has committed. Gated on permission for that URL, separately from url."
          },
          "title": {
            "type": "string",
            "optional": true,
            "description": "The tab's title. Same permission gating as url."
          },
          "favIconUrl": {
            "type": "string",
            "optional": true,
            "description": "The tab's favicon URL, if known. Same permission gating as url."
          },
          "status": {"$ref": "TabStatus", "optional": true, "description": "The tab's loading status."},
          "highlighted": {"type": "boolean", "description": "Whether this tab is highlighted. Orbit has no multi-tab selection, so this equals active."},
          "audible": {"type": "boolean", "optional": true, "description": "Whether the tab is producing sound."},
          "mutedInfo": {"$ref": "MutedInfo", "optional": true, "description": "The tab's muted state."},
          "discarded": {"type": "boolean", "description": "Whether the tab's content has been unloaded from memory."},
          "autoDiscardable": {"type": "boolean", "description": "Whether the tab may be discarded automatically. Always true -- Orbit has no per-tab opt-out."},
          "frozen": {"type": "boolean", "description": "Whether the tab is frozen. Always false -- Orbit never freezes a tab."},
          "groupId": {"type": "integer", "minimum": -1, "description": "tabGroups.TAB_GROUP_ID_NONE (-1) always -- Orbit has no tab groups."},
          "incognito": {"type": "boolean", "description": "Always false -- Orbit has no incognito profile yet."}
        }
      }
    ],
    "properties": {
      "TAB_ID_NONE": {
        "value": -1,
        "description": "An ID that represents the absence of a browser tab."
      }
    },
    "functions": [
      {
        "name": "get",
        "type": "function",
        "description": "Retrieves details about the specified tab.",
        "parameters": [
          {"type": "integer", "name": "tabId", "minimum": 0}
        ],
        "returns_async": {
          "name": "callback",
          "parameters": [
            {"name": "tab", "$ref": "Tab"}
          ]
        }
      },
      {
        "name": "getCurrent",
        "type": "function",
        "description": "Gets the tab that this script call is being made from. Returns undefined if called from a non-tab context.",
        "parameters": [],
        "returns_async": {
          "name": "callback",
          "parameters": [
            {"name": "tab", "$ref": "Tab", "optional": true}
          ]
        }
      },
      {
        "name": "query",
        "type": "function",
        "description": "Gets all tabs that have the specified properties, or all tabs if no properties are specified.",
        "parameters": [
          {
            "type": "object",
            "name": "queryInfo",
            "properties": {
              "active": {"type": "boolean", "optional": true, "description": "Whether the tabs are active in their windows."},
              "pinned": {"type": "boolean", "optional": true, "description": "Whether the tabs are pinned."},
              "highlighted": {"type": "boolean", "optional": true, "description": "Whether the tabs are highlighted."},
              "audible": {"type": "boolean", "optional": true, "description": "Whether the tabs are producing sound."},
              "muted": {"type": "boolean", "optional": true, "description": "Whether the tabs are muted."},
              "discarded": {"type": "boolean", "optional": true, "description": "Whether the tabs are discarded."},
              "autoDiscardable": {"type": "boolean", "optional": true, "description": "Whether the tabs may be discarded automatically."},
              "frozen": {"type": "boolean", "optional": true, "description": "Whether the tabs are frozen."},
              "currentWindow": {"type": "boolean", "optional": true, "description": "Whether the tabs are in the current window. False excludes the current window's tabs."},
              "lastFocusedWindow": {"type": "boolean", "optional": true, "description": "Whether the tabs are in the last focused window."},
              "windowId": {"type": "integer", "optional": true, "minimum": -2, "description": "The window to restrict the query to. windows.WINDOW_ID_CURRENT (-2) for the current window."},
              "windowType": {"$ref": "WindowType", "optional": true, "description": "The type of window the tabs are in."},
              "index": {"type": "integer", "optional": true, "minimum": 0, "description": "The position of the tabs within their windows."},
              "groupId": {"type": "integer", "optional": true, "minimum": -1, "description": "The group the tabs are in, or tabGroups.TAB_GROUP_ID_NONE (-1) for ungrouped tabs."},
              "status": {"$ref": "TabStatus", "optional": true, "description": "Whether the tabs are loading or complete."},
              "title": {"type": "string", "optional": true, "description": "Match page titles against a * / ? glob pattern. Only ever matches a tab this extension already has url-level permission to see."},
              "url": {
                "choices": [
                  {"type": "string"},
                  {"type": "array", "items": {"type": "string"}}
                ],
                "optional": true,
                "description": "Match tabs against one or more match patterns. Only ever matches a tab this extension already has url-level permission to see."
              }
            }
          }
        ],
        "returns_async": {
          "name": "callback",
          "parameters": [
            {"name": "result", "type": "array", "items": {"$ref": "Tab"}}
          ]
        }
      },
      {
        "name": "create",
        "type": "function",
        "description": "Creates a new tab.",
        "parameters": [
          {
            "type": "object",
            "name": "createProperties",
            "properties": {
              "windowId": {"type": "integer", "minimum": -2, "optional": true, "description": "The window in which to create the new tab. Defaults to the current window."},
              "url": {"type": "string", "optional": true, "description": "The URL to initially navigate the tab to. Defaults to the new tab page."},
              "active": {"type": "boolean", "optional": true, "description": "Whether the tab should become the active tab. Defaults to true."},
              "pinned": {"type": "boolean", "optional": true, "description": "Whether the tab should be pinned. Defaults to false."}
            }
          }
        ],
        "returns_async": {
          "name": "callback",
          "optional": true,
          "parameters": [
            {"name": "tab", "$ref": "Tab", "description": "The created tab."}
          ]
        }
      },
      {
        "name": "update",
        "type": "function",
        "description": "Modifies the properties of a tab. Properties not specified are not modified.",
        "parameters": [
          {"type": "integer", "name": "tabId", "minimum": 0, "optional": true, "description": "Defaults to the active tab of the current window."},
          {
            "type": "object",
            "name": "updateProperties",
            "properties": {
              "url": {"type": "string", "optional": true, "description": "A URL to navigate the tab to."},
              "active": {"type": "boolean", "optional": true, "description": "Whether the tab should be active."},
              "pinned": {"type": "boolean", "optional": true, "description": "Whether the tab should be pinned."}
            }
          }
        ],
        "returns_async": {
          "name": "callback",
          "optional": true,
          "parameters": [
            {"name": "tab", "$ref": "Tab", "optional": true}
          ]
        }
      },
      {
        "name": "remove",
        "type": "function",
        "description": "Closes one or more tabs.",
        "parameters": [
          {
            "name": "tabIds",
            "description": "The tab id or list of tab ids to close.",
            "choices": [
              {"type": "integer", "minimum": 0},
              {"type": "array", "items": {"type": "integer", "minimum": 0}}
            ]
          }
        ],
        "returns_async": {"name": "callback", "optional": true, "parameters": []}
      },
      {
        "name": "reload",
        "type": "function",
        "description": "Reloads a tab.",
        "parameters": [
          {"type": "integer", "name": "tabId", "minimum": 0, "optional": true, "description": "Defaults to the active tab of the current window."},
          {
            "type": "object",
            "name": "reloadProperties",
            "optional": true,
            "properties": {
              "bypassCache": {"type": "boolean", "optional": true, "description": "Whether to bypass local caching. Defaults to false."}
            }
          }
        ],
        "returns_async": {"name": "callback", "optional": true, "parameters": []}
      },
      {
        "name": "connect",
        "nocompile": true,
        "type": "function",
        "description": "Connects to the content script(s) in the specified tab. The chrome.runtime.onConnect event is fired in each content script running in the specified tab for the current extension.",
        "parameters": [
          {"type": "integer", "name": "tabId", "minimum": 0},
          {
            "type": "object",
            "name": "connectInfo",
            "optional": true,
            "properties": {
              "name": {"type": "string", "optional": true, "description": "Is passed into onConnect for content scripts that are listening for the connection event."},
              "frameId": {"type": "integer", "optional": true, "minimum": 0, "description": "Open a port to a specific frame identified by frameId instead of all frames in the tab."},
              "documentId": {"type": "string", "optional": true, "description": "Open a port to a specific document identified by documentId instead of all frames in the tab."}
            }
          }
        ],
        "returns": {
          "$ref": "runtime.Port",
          "description": "A port that can be used to communicate with the content scripts running in the specified tab."
        }
      },
      {
        "name": "sendMessage",
        "nocompile": true,
        "type": "function",
        "description": "Sends a single message to the content script(s) in the specified tab. The chrome.runtime.onMessage event is fired in each content script running in the specified tab for the current extension.",
        "parameters": [
          {"type": "integer", "name": "tabId", "minimum": 0},
          {"type": "any", "name": "message", "description": "The message to send. This message should be a JSON-ifiable object."},
          {
            "type": "object",
            "name": "options",
            "optional": true,
            "properties": {
              "frameId": {"type": "integer", "optional": true, "minimum": 0, "description": "Send a message to a specific frame identified by frameId instead of all frames in the tab."},
              "documentId": {"type": "string", "optional": true, "description": "Send a message to a specific document identified by documentId instead of all frames in the tab."}
            }
          }
        ],
        "returns_async": {
          "name": "callback",
          "optional": true,
          "description": "Promise that resolves with the response from the content script. If an error occurs while connecting to the specified tab, the promise will be rejected.",
          "parameters": [
            {"name": "response", "type": "any", "description": "The JSON response object sent by the handler of the message."}
          ]
        }
      }
    ],
    "events": [
      {
        "name": "onCreated",
        "type": "function",
        "description": "Fired when a tab is created. The tab's URL may not be set yet -- listen for onUpdated to be notified when it is.",
        "parameters": [
          {"$ref": "Tab", "name": "tab", "description": "Details of the tab that was created."}
        ]
      },
      {
        "name": "onUpdated",
        "type": "function",
        "description": "Fired when a tab is updated.",
        "parameters": [
          {"type": "integer", "name": "tabId", "minimum": 0},
          {
            "type": "object",
            "name": "changeInfo",
            "properties": {
              "status": {"$ref": "TabStatus", "optional": true, "description": "The tab's loading status."},
              "url": {"type": "string", "optional": true, "description": "The tab's URL if it has changed."},
              "pinned": {"type": "boolean", "optional": true, "description": "The tab's new pinned state."},
              "title": {"type": "string", "optional": true, "description": "The tab's new title."},
              "favIconUrl": {"type": "string", "optional": true, "description": "The tab's new favicon URL."}
            }
          },
          {"$ref": "Tab", "name": "tab", "description": "Gives the state of the tab that was updated."}
        ]
      },
      {
        "name": "onMoved",
        "type": "function",
        "description": "Fired when a tab is moved within a window.",
        "parameters": [
          {"type": "integer", "name": "tabId", "minimum": 0},
          {
            "type": "object",
            "name": "moveInfo",
            "properties": {
              "windowId": {"type": "integer", "minimum": 0},
              "fromIndex": {"type": "integer", "minimum": 0},
              "toIndex": {"type": "integer", "minimum": 0}
            }
          }
        ]
      },
      {
        "name": "onActivated",
        "type": "function",
        "description": "Fires when the active tab in a window changes.",
        "parameters": [
          {
            "type": "object",
            "name": "activeInfo",
            "properties": {
              "tabId": {"type": "integer", "minimum": 0, "description": "The id of the tab that has become active."},
              "windowId": {"type": "integer", "minimum": 0, "description": "The id of the window the active tab changed inside of."}
            }
          }
        ]
      },
      {
        "name": "onRemoved",
        "type": "function",
        "description": "Fired when a tab is closed.",
        "parameters": [
          {"type": "integer", "name": "tabId", "minimum": 0},
          {
            "type": "object",
            "name": "removeInfo",
            "properties": {
              "windowId": {"type": "integer", "minimum": 0, "description": "The window whose tab is closed."},
              "isWindowClosing": {"type": "boolean", "description": "True when the tab was closed because its parent window was closed."}
            }
          }
        ]
      },
      {
        "name": "onReplaced",
        "type": "function",
        "description": "Fired when a tab is replaced with another tab because the browser swapped its contents for a pre-rendered or pre-loaded one. Orbit never does this -- it has no prerendering, no NoStatePrefetch and no in-place tab discarding -- so this event has no source and never fires. It is declared because that is the truth Chrome's own API expresses: the condition simply does not occur here.",
        "parameters": [
          {"type": "integer", "name": "addedTabId", "minimum": 0},
          {"type": "integer", "name": "removedTabId", "minimum": 0}
        ]
      }
    ]
  }
]
