# Chromium source and build output — fetched by Scripts/chromium, never committed (tens of GB).
# Excludes the contents, not the directory itself, so the submodule below can be re-included.
ThirdParty/*
!ThirdParty/depot_tools

# Generated from Chromium/chromium-version.json by Scripts/chromium sync.
Chromium/Generated/

# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/

# Python bytecode from Scripts/
__pycache__/
*.pyc

# Signing material. None of this may ever be committed: the Sparkle EdDSA
# private key signs every update this app will ever install, so a leak is not
# recoverable by rotating it -- existing installs carry the matching public key
# in their Info.plist and would keep trusting the compromised one until each
# user manually replaced the app. docs/RELEASING.md tells a maintainer to run
# `generate_keys`, whose export form writes a plain text file, and the obvious
# place to run that is this directory. These patterns exist so that doing the
# obvious thing cannot end in a published key.
*.pem
*.p12
*.p8
*.key
privkey*.txt
*private*key*.txt
.env

# Sparkle's appcast tooling. `generate_appcast` writes the feed, and moves
# superseded archives into old_updates/, into whatever directory it is pointed
# at. CI does this in RUNNER_TEMP, but running it by hand to debug a release
# does it wherever you happen to be standing.
appcast.xml
old_updates/

# xcodebuild result bundles. Written by `xcodebuild test -resultBundlePath`,
# hundreds of megabytes, and regenerated by every run.
*.xcresult

# macOS
.DS_Store

refs