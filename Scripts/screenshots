#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

cd "${REPO_ROOT}"

echo "screenshots: regenerating refs/screenshots/*.png (this does not launch Orbit.app interactively)"

xcodebuild \
  -project Orbit.xcodeproj \
  -scheme Orbit \
  -configuration Debug \
  -destination 'platform=macOS,arch=arm64' \
  -only-testing:OrbitAppTests/ScreenshotGenerationTests \
  test

echo "screenshots: done — see refs/screenshots/README.md for what each image shows."
