#!/usr/bin/env bash
# What a test run really ran, checked against what the sources declare. Used by the plain
# `xcodebuild test` path in CI and by Scripts/live-engine-tests.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
elif [ -x /usr/bin/python3 ]; then
  PYTHON=/usr/bin/python3
else
  echo "error: python3 is required. Install the Xcode Command Line Tools with 'xcode-select --install'." >&2
  exit 1
fi

exec "$PYTHON" "$SCRIPT_DIR/test_verdict.py" "$@"
