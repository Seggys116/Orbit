#!/usr/bin/env bash
# Static security invariants (WebKit security preferences, entitlement policy,
# and the four that keep a development or test run off the real user's data:
# scoped preferences, scoped data root, a single production identity, and the
# engine's persistent-profile scope gate); run with no argument for all of them.
# Runtime counterpart: OrbitTests/SandboxInvariantTests.swift.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
elif [ -x /usr/bin/python3 ]; then
  PYTHON=/usr/bin/python3
else
  echo "error: python3 is required. Install the Xcode Command Line Tools with 'xcode-select --install'." >&2
  exit 1
fi

exec "$PYTHON" "$SCRIPT_DIR/security_guards.py" "$@"
