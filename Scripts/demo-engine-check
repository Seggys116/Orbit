#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${REPO_ROOT}"

BUILD=1
if [ "${1:-}" = "--no-build" ]; then
  BUILD=0
fi

DERIVED="${REPO_ROOT}/build/DemoEngineCheck"
APP="${DERIVED}/Build/Products/Debug/OrbitDemo.app"

if [ "${BUILD}" = "1" ]; then
  echo "demo-engine-check: building the Demo scheme"
  xcodebuild \
    -project Orbit.xcodeproj \
    -scheme Demo \
    -configuration Debug \
    -destination 'platform=macOS,arch=arm64' \
    -derivedDataPath "${DERIVED}" \
    build
fi

if [ ! -d "${APP}" ]; then
  echo "error: ${APP} does not exist. Run without --no-build." >&2
  exit 1
fi

echo
echo "demo-engine-check: contents of ${APP}/Contents/Frameworks"
ls -1 "${APP}/Contents/Frameworks" 2>/dev/null || echo "  (no Frameworks directory at all)"
echo

# Run the executable directly: `open -W` returns the launcher's status, not the app's.
echo "demo-engine-check: launching the demo with the probe enabled"
set +e
ORBIT_DEMO_ENGINE_PROBE=1 "${APP}/Contents/MacOS/OrbitDemo"
status=$?
set -e

echo
if [ "${status}" -eq 0 ]; then
  echo "demo-engine-check: PASS"
else
  echo "demo-engine-check: FAIL (exit ${status})"
fi
exit "${status}"
