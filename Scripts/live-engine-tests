#!/bin/bash
# Run the live WebKit suites (OrbitAppTests files that start a real engine through WebKitLiveEngineHost) and fail unless every declared test executed and passed.
#
# Usage: Scripts/live-engine-tests [--list] [--skip-build] [--suite NAME]... [--expect N] [--test-timeout SECONDS]
#                                  [--derived-data DIR] [--results-dir DIR] [--destination SPEC] [-- xcodebuild build args]
#
# Suites are discovered from the sources and run together in one test process, with parallelisation off. Every suite starts the engine it needs itself
# (WebKitLiveEngineHost.sharedEngine() or withFreshEngine), so none needs a process of its own, and none may skip.
#
# Every pass runs under XCTest's per-test timeout (600s default), so a test that never returns fails by name. `--expect N` asserts what discovery finds; it
# cannot replace the count. Scripts/test-verdict works out the verdict from the result bundles and logs.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
cd "${REPO_ROOT}"

TEST_TARGET="OrbitAppTests"
SCHEME="Orbit"

DERIVED_DATA="DerivedData"
DESTINATION="platform=macOS,arch=arm64"
CONFIGURATIONS="baseline"
RESULTS_DIR=""
SKIP_BUILD=0
LIST_ONLY=0
EXPECTED_OVERRIDE=""
TEST_TIMEOUT=600
BUILD_ARGS=()
REQUESTED_SUITES=()

usage() {
  sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed -e 's/^# \{0,1\}//' -e '$d'
}

plural() {
  if [ "$1" -eq 1 ]; then
    printf '%s %s' "$1" "$2"
  else
    printf '%s %ss' "$1" "$2"
  fi
}

# Without this, `set -u` reports a valueless flag as "$2: unbound variable".
need_value() {
  if [ "$#" -lt 2 ] || [ -z "$2" ]; then
    echo "error: $1 needs a value. Run '$0 --help'." >&2
    exit 2
  fi
}

while [ $# -gt 0 ]; do
  case "$1" in
    --list)             LIST_ONLY=1; shift ;;
    --skip-build)       SKIP_BUILD=1; shift ;;
    --derived-data)     need_value "$@"; DERIVED_DATA="$2"; shift 2 ;;
    --results-dir)      need_value "$@"; RESULTS_DIR="$2"; shift 2 ;;
    --destination)      need_value "$@"; DESTINATION="$2"; shift 2 ;;
    --expect)           need_value "$@"; EXPECTED_OVERRIDE="$2"; shift 2 ;;
    --test-timeout)     need_value "$@"; TEST_TIMEOUT="$2"; shift 2 ;;
    --suite)            need_value "$@"; REQUESTED_SUITES[${#REQUESTED_SUITES[@]}]="$2"; shift 2 ;;
    --configurations)   need_value "$@"; CONFIGURATIONS="$(printf '%s' "$2" | tr ',' ' ')"; shift 2 ;;
    -h|--help)          usage; exit 0 ;;
    --)                 shift; while [ $# -gt 0 ]; do BUILD_ARGS[${#BUILD_ARGS[@]}]="$1"; shift; done ;;
    *)
      echo "error: unknown argument '$1'. Run '$0 --help'." >&2
      exit 2
      ;;
  esac
done

case "${TEST_TIMEOUT}" in
  ''|*[!0-9]*)
    echo "error: --test-timeout takes a whole number of seconds, not '${TEST_TIMEOUT}'." >&2
    exit 2
    ;;
esac

if [ "${TEST_TIMEOUT}" -lt 1 ]; then
  echo "error: --test-timeout 0 would switch the per-test timeout off, and a test that then never returns hangs this run to its outer timeout with no verdict at all -- the silent outcome this script exists to prevent." >&2
  echo "note: the default is 600s; pass a larger number if a live test legitimately needs longer." >&2
  exit 2
fi

if [ -n "${EXPECTED_OVERRIDE}" ]; then
  case "${EXPECTED_OVERRIDE}" in
    ''|*[!0-9]*)
      echo "error: --expect takes a whole number of tests, not '${EXPECTED_OVERRIDE}'." >&2
      exit 2
      ;;
  esac
  if [ "${EXPECTED_OVERRIDE}" -lt 1 ]; then
    echo "error: --expect ${EXPECTED_OVERRIDE} cannot be satisfied by any run: a verdict over zero live tests is not a pass." >&2
    exit 2
  fi
fi

# XCTest's own timeout, not a wrapper around xcodebuild: it fails the individual test that overran, by name, and lets the pass finish and report.
TIMEOUT_ARGS=(
  -test-timeouts-enabled YES
  -default-test-execution-time-allowance "${TEST_TIMEOUT}"
  -maximum-test-execution-time-allowance "${TEST_TIMEOUT}"
)

for configuration in ${CONFIGURATIONS}; do
  case "${configuration}" in
    baseline) ;;
    *)
      echo "error: unknown configuration '${configuration}'. Known: baseline." >&2
      exit 2
      ;;
  esac
done

# A live suite is a file with a non-comment reference to WebKitLiveEngineHost.
# Discovery matches any `...TestCase` superclass (the corpus suites subclass CorpusLiveTestCase): a suite that dropped out would leave the run green over tests it never ran.

SUITES=()
SUITE_TESTS=()
EXPECTED_TESTS=0

for file in OrbitAppTests/*.swift; do
  found="$(awk '
    /^[[:space:]]*\/\// { next }
    /WebKitLiveEngineHost\./ { guarded = 1 }
    /^(final )?class [A-Za-z0-9_]+[[:space:]]*:[[:space:]]*[A-Za-z0-9_]*TestCase/ {
      if (name == "") {
        name = $0
        sub(/^(final )?class[[:space:]]+/, "", name)
        sub(/[[:space:]]*:.*$/, "", name)
      }
    }
    /^[[:space:]]*func test/ { tests++ }
    END { if (guarded && name != "") printf "%s %d\n", name, tests + 0 }
  ' "${file}")"
  [ -n "${found}" ] || continue
  read -r name count <<< "${found}"

  # `--suite` must narrow the run and the expected count together.
  if [ ${#REQUESTED_SUITES[@]} -gt 0 ]; then
    wanted=0
    for requested in "${REQUESTED_SUITES[@]}"; do
      if [ "${requested}" = "${name}" ]; then
        wanted=1
      fi
    done
    [ "${wanted}" -eq 1 ] || continue
  fi

  SUITES[${#SUITES[@]}]="${name}"
  SUITE_TESTS[${#SUITE_TESTS[@]}]="${count}"
  EXPECTED_TESTS=$((EXPECTED_TESTS + count))
done

if [ ${#SUITES[@]} -eq 0 ]; then
  if [ ${#REQUESTED_SUITES[@]} -gt 0 ]; then
    echo "error: none of the requested suites are live-engine suites: ${REQUESTED_SUITES[*]}" >&2
    echo "note: run without --suite, or with --list, to see the ones that are." >&2
  else
    echo "error: no live-engine suites found under OrbitAppTests/." >&2
    echo "note: a live suite is a file declaring an XCTestCase subclass that uses" >&2
    echo "note: WebKitLiveEngineHost. If that was renamed, update the discovery awk." >&2
  fi
  exit 1
fi

if [ -n "${EXPECTED_OVERRIDE}" ] && [ "${EXPECTED_OVERRIDE}" -ne "${EXPECTED_TESTS}" ]; then
  echo "error: --expect ${EXPECTED_OVERRIDE}, but discovery found ${EXPECTED_TESTS} live tests in the sources." >&2
  echo "note: --expect asserts what discovery should find; it cannot replace it. Run --list to see the suites and counts, then fix whichever of the two is wrong." >&2
  exit 1
fi

# One pass is one xcodebuild test process, and every suite shares it.
SHARED_SUITES=("${SUITES[@]}")
SHARED_EXPECTED=${EXPECTED_TESTS}
PASS_COUNT=1

echo "live-engine-tests: $(plural ${#SUITES[@]} "live suite"), $(plural "${EXPECTED_TESTS}" test), configurations: ${CONFIGURATIONS}"
index=0
while [ "${index}" -lt ${#SUITES[@]} ]; do
  echo "live-engine-tests:   ${TEST_TARGET}/${SUITES[${index}]} ($(plural "${SUITE_TESTS[${index}]}" test))"
  index=$((index + 1))
done

echo "live-engine-tests: per-test timeout ${TEST_TIMEOUT}s"

echo "live-engine-tests: 1 test process per configuration"

if [ "${LIST_ONLY}" -eq 1 ]; then
  exit 0
fi

if [ "${SKIP_BUILD}" -eq 1 ]; then
  echo "live-engine-tests: --skip-build, reusing whatever is in ${DERIVED_DATA}/Build/Products"
else
  echo "live-engine-tests: building for testing"
  xcodebuild build-for-testing \
    -project Orbit.xcodeproj \
    -scheme "${SCHEME}" \
    -configuration Debug \
    -destination "${DESTINATION}" \
    -derivedDataPath "${DERIVED_DATA}" \
    ${BUILD_ARGS[@]+"${BUILD_ARGS[@]}"}
fi

PRODUCTS_DIR="${DERIVED_DATA}/Build/Products"

# xcodebuild's own plan is named "<Scheme>_<platform>-<arch>.xctestrun" -- an
# underscore right after the scheme name. Everything else in this directory
# is something else: one of ours (Orbit-live-engine-*, hyphenated), or a
# stale orphan left by some earlier, now-unrelated flow (also hyphenated --
# e.g. a probe plan nothing here generates any more). Looking for the
# underscore name first means an orphan is never a candidate to guess
# between; it simply doesn't match.
PRISTINE_PLANS=()
for plan in "${PRODUCTS_DIR}/${SCHEME}"_*.xctestrun; do
  [ -e "${plan}" ] || continue
  PRISTINE_PLANS[${#PRISTINE_PLANS[@]}]="${plan}"
done

if [ ${#PRISTINE_PLANS[@]} -eq 1 ]; then
  SOURCE_PLAN="${PRISTINE_PLANS[0]}"
elif [ ${#PRISTINE_PLANS[@]} -gt 1 ]; then
  echo "error: ${#PRISTINE_PLANS[@]} plans match xcodebuild's own '${SCHEME}_<platform>-<arch>.xctestrun' naming in ${PRODUCTS_DIR}, so which one to patch is a guess:" >&2
  printf 'note:   %s\n' "${PRISTINE_PLANS[@]}" >&2
  echo "note: point --derived-data at a tree built for a single destination, or --destination at the one that matches a single plan." >&2
  exit 1
else
  # Fallback for an xcodebuild that isn't using the underscore naming this
  # was written against: any single .xctestrun that isn't one of ours. Stale
  # hyphenated orphans still make this ambiguous -- that's the one case this
  # script genuinely cannot resolve on its own.
  PLANS=()
  for plan in "${PRODUCTS_DIR}"/*.xctestrun; do
    case "${plan}" in
      *"-live-engine-"*.xctestrun) continue ;;   # one of ours from a previous run
    esac
    [ -e "${plan}" ] || continue
    PLANS[${#PLANS[@]}]="${plan}"
  done

  if [ ${#PLANS[@]} -eq 0 ]; then
    echo "error: no .xctestrun in ${PRODUCTS_DIR}." >&2
    echo "note: run without --skip-build, or point --derived-data at the tree that has one." >&2
    exit 1
  fi
  if [ ${#PLANS[@]} -gt 1 ]; then
    echo "error: ${#PLANS[@]} .xctestrun files in ${PRODUCTS_DIR}, none named '${SCHEME}_<platform>-<arch>.xctestrun', so which one to patch is a guess:" >&2
    printf 'note:   %s\n' "${PLANS[@]}" >&2
    echo "note: this xcodebuild isn't using the scheme-underscore naming this script looks for first; rebuild with --skip-build off, or point --derived-data at a tree with exactly one non-live-engine plan." >&2
    exit 1
  fi
  SOURCE_PLAN="${PLANS[0]}"
fi
echo "live-engine-tests: test plan ${SOURCE_PLAN}"

# Per-run directory: xcodebuild refuses to overwrite an existing result bundle.
if [ -z "${RESULTS_DIR}" ]; then
  RESULTS_DIR="${DERIVED_DATA}/LiveEngineResults/$(date +%Y%m%d-%H%M%S)"
fi
mkdir -p "${RESULTS_DIR}"

# One xcodebuild test process, over the suites it is given. Each pass appends a row to the configuration's ledger; the verdict is worked out once, over every row,
# only after all of them have run -- a pass that dies must not stop the others from producing their evidence.
# Row: label, kind, expected, xcodebuild status, passes seen in the log, skips seen in the log, summary JSON ("-" when it could not be read), the log itself.
run_pass() {
  local configuration="$1" label="$2" kind="$3" plan="$4" ledger="$5" expected="$6"
  shift 6
  local suite slug result_bundle log summary_json
  local xcodebuild_status summary_status log_passed log_skipped
  local only_testing
  only_testing=()
  for suite in "$@"; do
    only_testing[${#only_testing[@]}]="-only-testing:${TEST_TARGET}/${suite}"
  done

  # The shared pass keeps the plain per-configuration names, so `baseline.log` and `baseline.xcresult` still mean what they have always meant.
  if [ "${kind}" = "shared" ]; then
    slug="${configuration}"
  else
    slug="${configuration}-${label}"
  fi
  result_bundle="${RESULTS_DIR}/${slug}.xcresult"
  log="${RESULTS_DIR}/${slug}.log"
  summary_json="${RESULTS_DIR}/${slug}-summary.json"

  echo
  echo "live-engine-tests: --- ${configuration}: ${label} ($(plural $# suite), $(plural "${expected}" test), ${kind} process) ---"

  set +e
  xcodebuild test-without-building \
    -xctestrun "${plan}" \
    -destination "${DESTINATION}" \
    -parallel-testing-enabled NO \
    -resultBundlePath "${result_bundle}" \
    ${TIMEOUT_ARGS[@]+"${TIMEOUT_ARGS[@]}"} \
    "${only_testing[@]}" 2>&1 | tee "${log}"
  xcodebuild_status=${PIPESTATUS[0]}
  set -e

  log_passed="$(awk '/Test Case .* passed \(/ { n++ } END { print n + 0 }' "${log}")"
  log_skipped="$(awk '/Test Case .* skipped \(/ { n++ } END { print n + 0 }' "${log}")"

  # --schema-version is pinned so a schema change fails loudly rather than handing back a document with moved field names.
  set +e
  xcrun xcresulttool get test-results summary \
    --schema-version 0.1.0 \
    --path "${result_bundle}" > "${summary_json}" 2>"${summary_json}.err"
  summary_status=$?
  set -e

  if [ "${summary_status}" -ne 0 ]; then
    echo "error: could not read ${result_bundle}:" >&2
    cat "${summary_json}.err" >&2
    echo "note: xcodebuild exited ${xcodebuild_status}; the log is ${log}" >&2
    summary_json="-"
  fi

  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "${label}" "${kind}" "${expected}" "${xcodebuild_status}" "${log_passed}" "${log_skipped}" "${summary_json}" "${log}" >> "${ledger}"
}

# Called from an `if !`, which switches `set -e` off for everything it runs, so every step that can fail takes and checks its own status.
run_configuration() {
  local configuration="$1"
  local patched_plan="${PRODUCTS_DIR}/Orbit-live-engine-${configuration}.xctestrun"
  local ledger="${RESULTS_DIR}/${configuration}-passes.tsv"
  local patch_status

  echo
  echo "live-engine-tests: === ${configuration} ==="

  set +e
  python3 - "${SOURCE_PLAN}" "${patched_plan}" "${TEST_TARGET}" "${configuration}" <<'PY'
import plistlib
import sys

source, destination, target_name, configuration = sys.argv[1:5]

variables = {"ORBIT_LIVE_ENGINE": "1"}

with open(source, "rb") as handle:
    plan = plistlib.load(handle)

# FormatVersion 1 keys targets by name at the top level; 2 and 3 nest them under TestConfigurations. An unhandled shape patches nothing and skips everything silently.
targets = []
if "TestConfigurations" in plan:
    for test_configuration in plan["TestConfigurations"]:
        targets.extend(test_configuration.get("TestTargets", []))
else:
    targets.extend(
        value for key, value in plan.items()
        if key != "__xctestrun_metadata__" and isinstance(value, dict)
    )

patched = 0
for target in targets:
    if target.get("BlueprintName") != target_name:
        continue
    environment = dict(target.get("EnvironmentVariables") or {})
    environment.update(variables)
    target["EnvironmentVariables"] = environment
    # Both spellings appear depending on whether the target is hosted; either left true splits the live classes across processes, i.e. a second browser process start.
    for key in ("InProcessParallelizationEnabled", "ParallelizationEnabled"):
        if key in target:
            target[key] = False
    patched += 1

if patched != 1:
    sys.exit(
        f"error: expected exactly one '{target_name}' target in {source}, patched {patched}. "
        "The test plan's shape changed; this script's patcher has to change with it."
    )

with open(destination, "wb") as handle:
    plistlib.dump(plan, handle)

print("live-engine-tests: patched " + ", ".join(
    f"{name}={value}" for name, value in sorted(variables.items())
) + f" into {destination}")
PY
  patch_status=$?
  set -e
  if [ "${patch_status}" -ne 0 ]; then
    return 1
  fi

  : > "${ledger}"

  run_pass "${configuration}" "shared-engine" "shared" "${patched_plan}" "${ledger}" \
    "${SHARED_EXPECTED}" "${SHARED_SUITES[@]}"

  "${SCRIPT_DIR}/test-verdict" live \
    --ledger "${ledger}" \
    --configuration "${configuration}" \
    --expected "${EXPECTED_TESTS}" \
    --expected-passes "${PASS_COUNT}" \
    --source-dir "${TEST_TARGET}"
}

status=0
for configuration in ${CONFIGURATIONS}; do
  if ! run_configuration "${configuration}"; then
    status=1
    echo "live-engine-tests: ${configuration} FAILED" >&2
  fi
done

echo
if [ "${status}" -eq 0 ]; then
  echo "live-engine-tests: every configuration green (${CONFIGURATIONS// /, }), ${EXPECTED_TESTS} live tests each, in one test process each."
else
  echo "live-engine-tests: FAILED. Logs and result bundles: ${RESULTS_DIR}" >&2
fi
echo "live-engine-tests: results in ${RESULTS_DIR}"

exit "${status}"
