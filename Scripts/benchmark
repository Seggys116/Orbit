#!/usr/bin/env bash
# Performance and memory benchmarks. Manual tool: nothing here runs in CI. Methodology: refs/PERFORMANCE.md.
#
#   Scripts/benchmark run                          build Release Orbit, 5 attempts of every metric
#   Scripts/benchmark run --attempts 1 --skip-build --metrics launch,memory --pages light --tab-counts 1,5
#   Scripts/benchmark measure-running --process-match "/Applications/Some Browser.app" \
#       --page light --tabs-open 10                sample a browser you already started (never launches one)
#   Scripts/benchmark serve --page light --tabs 10 URLs to open by hand in that browser
#   Scripts/benchmark compare A.json B.json        markdown table, refuses mismatched versions
#
# `run` only ever launches Orbit. Orbit is driven through Orbit/Core/AppSmokeProbe.swift
# (ORBIT_SMOKE_PROBE=1 and ORBIT_SMOKE_PROBE_BENCH=1), which keeps every launch off the real profile.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
elif [ -x /usr/bin/python3 ]; then
  PYTHON=/usr/bin/python3
else
  echo "error: python3 is required. Install the Xcode Command Line Tools with 'xcode-select --install'." >&2
  exit 1
fi

exec "$PYTHON" "$SCRIPT_DIR/benchmark.py" "$@"
