#!/usr/bin/env bash
# Updates a scratch copy of a real signed build with the real Sparkle, end to end.
#
#   Scripts/updater-e2e --base Orbit-1.0.2.dmg --current Orbit-1.0.3.dmg --target-dmg Orbit-1.0.3.dmg
#   Scripts/updater-e2e --case substituted-app --base Orbit-1.0.2.dmg
#
# Every case works on copies under --work. Nothing here touches an installed Orbit,
# and the run refuses to start while one is running.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
elif [ -x /usr/bin/python3 ]; then
  PYTHON=/usr/bin/python3
else
  echo "error: python3 is required. Install the Xcode Command Line Tools with 'xcode-select --install'." >&2
  exit 1
fi

exec "$PYTHON" "$SCRIPT_DIR/updater_e2e.py" "$@"
